		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-hbs": "^1.0.3",
		"eslint-plugin-html": "^8.1.2",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-tailwindcss": "^3.17.5",
		"eslint-plugin-vue": "^9.32.0",
		"glob": "11.0.0",
		"handlebars": "^4.7.8",
